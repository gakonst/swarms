{
  "name": "swarms",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -b",
    "check:e2e": "tsc -p test/e2e/tsconfig.json",
    "db:migrate": "wrangler d1 migrations apply swarms --remote",
    "db:migrate:local": "wrangler d1 migrations apply swarms --local",
    "deploy": "vite build && wrangler deploy",
    "e2e": "node --test --experimental-strip-types --test-concurrency=1 test/e2e/*.test.ts",
    "gen:types": "wrangler types worker-configuration.d.ts",
    "mock:gateway": "node --experimental-strip-types test/mock/gateway.ts",
    "mock:github": "node --experimental-strip-types test/mock/github.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pierre/diffs": "1.6.2",
    "@resvg/resvg-wasm": "2.6.2",
    "accounts": "1.3.20261123214053",
    "hono": "^4.13.14",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "nanocode-ts": "https://github.com/nanocodexyz/nanocode-ts/releases/download/build-887f3cc/nanocode-ts-887f3cc.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "viem": "2.57.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "6.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
