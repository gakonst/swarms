{
  "name": "swarms",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -b",
    "db:migrate": "wrangler d1 migrations apply swarms --remote",
    "db:migrate:local": "wrangler d1 migrations apply swarms --local",
    "deploy": "vite build && wrangler deploy",
    "gen:types": "wrangler types worker-configuration.d.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pierre/diffs": "1.6.2",
    "@resvg/resvg-wasm": "2.6.2",
    "accounts": "1.0.0-alpha.20261116052638-4550531",
    "hono": "^4.13.14",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "nanocode-ts": "https://github.com/nanocodexyz/nanocode-ts/releases/download/build-c38629c/nanocode-ts-c38629c.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "viem": "2.57.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "6.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
