{
  "name": "swarms",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -b",
    "db:migrate": "wrangler d1 migrations apply swarms --remote",
    "db:migrate:local": "wrangler d1 migrations apply swarms --local",
    "deploy": "vite build && wrangler deploy",
    "gen:types": "wrangler types worker-configuration.d.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pierre/diffs": "1.6.2",
    "@pierre/trees": "1.0.0-beta.6",
    "accounts": "0.21.0",
    "hono": "^4.13.14",
    "mppx": "0.16.0",
    "nanocode-ts": "https://github.com/gakonst/nanocode-ts/releases/download/build-8f97ea7/nanocode-ts-8f97ea7.tgz",
    "ox": "0.14.56",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "viem": "2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "6.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
